{
  "expo": {
    "name": "SUNSU",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sunsu",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.sunsuecom.irvcph",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Set your delivery location for accurate delivery."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#15803D"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.sunsuecom.irvcph",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Set your delivery location for accurate delivery."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
